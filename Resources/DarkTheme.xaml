<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <Color x:Key="AccentColor">#60CDFF</Color>
    <Color x:Key="AccentLightColor">#98DFFF</Color>
    <Color x:Key="SurfaceColor">#202020</Color>
    <Color x:Key="SurfaceCardColor">#2D2D2D</Color>
    <Color x:Key="SurfaceBorderColor">#404040</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#9E9E9E</Color>
    <Color x:Key="TextOnAccentColor">#003A52</Color>
    <Color x:Key="SuccessColor">#6CCB5F</Color>
    <Color x:Key="WarningColor">#FCD116</Color>
    <Color x:Key="ErrorColor">#FF6B6B</Color>
    <Color x:Key="DragOverBorderColor">#60CDFF</Color>

</ResourceDictionary>
