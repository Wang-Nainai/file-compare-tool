<Window x:Class="FileCompareTool.Views.MatchDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Detail_WindowTitle}"
        Width="840"
        Height="560"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/FluentStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource AppIconTile}" Width="40" Height="40">
                <TextBlock Text="&#xE7C3;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="19"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding FileName, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{DynamicResource Detail_Subtitle}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource AccentPill}" Padding="10,4" Margin="0,0,7,0">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource AccentBrush}">
                        <Run Text="{DynamicResource Detail_A_CountLabel}"/><Run Text="{Binding ACount, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Border>
                <Border Style="{StaticResource DangerPill}" Padding="10,4">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource ErrorBrush}">
                        <Run Text="{DynamicResource Detail_B_CountLabel}"/><Run Text="{Binding BCount, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- A files -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Main_A_Section}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource PillBorder}" Padding="8,2">
                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding ACount, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><Run Text="{DynamicResource Unit_FilesWithSpace}"/>
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding AFiles, RelativeSource={RelativeSource AncestorType=Window}}"
                             MouseDoubleClick="OnFileDoubleClick"
                             MouseRightButtonUp="OnFileRightClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource ExtensionTile}" Width="34" Height="34" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding ExtensionLabel}"
                                                       FontSize="8.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullPath}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"
                                                       ToolTip="{Binding FullPath}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- B files -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource ErrorBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Main_B_Section}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource PillBorder}" Padding="8,2">
                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}">
                                <Run Text="{Binding BCount, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/><Run Text="{DynamicResource Unit_FilesWithSpace}"/>
                            </TextBlock>
                        </Border>
                    </DockPanel>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding BFiles, RelativeSource={RelativeSource AncestorType=Window}}"
                             MouseDoubleClick="OnFileDoubleClick"
                             MouseRightButtonUp="OnFileRightClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource ExtensionTile}" Width="34" Height="34" Margin="0,0,10,0" Background="#FBF3F2">
                                            <TextBlock Text="{Binding ExtensionLabel}"
                                                       FontSize="8.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ErrorBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullPath}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"
                                                       ToolTip="{Binding FullPath}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4" Background="#ECECEC" CornerRadius="8" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{DynamicResource Detail_FooterOpen}"
                           FontSize="10.5"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="·" FontSize="10.5" Foreground="{StaticResource TextTertiaryBrush}" Margin="10,0"/>
                <TextBlock Text="{DynamicResource Detail_FooterInfo}"
                           FontSize="10.5"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
