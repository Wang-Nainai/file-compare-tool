<Window x:Class="FileCompareTool.Views.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Confirm_WindowTitle}"
        Width="480"
        Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/FluentStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="46" Height="46" CornerRadius="12" Background="#FDF3E7">
                <TextBlock Text="&#xE7BA;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="21"
                           Foreground="{StaticResource WarningBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Confirm_Heading}"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Confirm_Subheading}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Message -->
        <StackPanel Grid.Row="2">
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="{StaticResource TextPrimaryBrush}">
                <Run Text="{DynamicResource Confirm_MessagePrefix}"/><Run Text="{Binding FileCount, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"/><Run Text="{DynamicResource Confirm_MessageSuffix}"/>
            </TextBlock>

            <Border Background="#FFFFFF"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="12,9"
                    Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Top"
                               Margin="0,1,8,0"/>
                    <TextBlock Text="{DynamicResource Confirm_Info}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Width="360"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Button_Cancel}"
                    Style="{StaticResource FluentButton}"
                    IsCancel="True"
                    Width="100"
                    Height="34"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Confirm_Action}"
                    Style="{StaticResource FluentDangerButton}"
                    Click="OnConfirmClick"
                    IsDefault="True"
                    Width="108"
                    Height="34"/>
        </StackPanel>
    </Grid>
</Window>
